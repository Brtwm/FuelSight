# Copy to /opt/fuelsight/env/production.env on the VPS and chmod 600.
# Never commit the real file. Copy existing LLM/API values without changing them.

APP_ENV=production
APP_PORT=8061
APP_VERSION=0.1.0
ENABLE_API_DOCS=false
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=fuelsight
POSTGRES_USER=fuelsight
POSTGRES_PASSWORD=GENERATE_A_UNIQUE_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://fuelsight:GENERATE_A_UNIQUE_DATABASE_PASSWORD@db:5432/fuelsight

JWT_SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=1
AUTH_REFRESH_COOKIE_NAME=fuelsight_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth

ENABLE_LLM=true
LLM_PROVIDER_MODE=cloud_first
LLM_PROVIDER=neuraldeep
LLM_OPENAI_COMPAT_BASE_URL=https://api.neuraldeep.ru/v1
LLM_API_KEY=COPY_FROM_LOCAL_ENV_WITHOUT_CHANGES
LLM_CHAT_MODEL=gpt-oss-120b
LLM_EMBEDDING_MODEL=bge-m3
LLM_RERANKER_MODEL=bge-reranker
LLM_TIMEOUT_SECONDS=60
LLM_MAX_EVIDENCE_CHARS=6000
LLM_EMBEDDING_DIMENSIONS=64
GIGACHAT_AUTH_KEY=COPY_FROM_LOCAL_ENV_WITHOUT_CHANGES
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CHAT_MODEL=GigaChat
GIGACHAT_EMBEDDING_MODEL=EmbeddingsGigaR

ENABLE_EXTERNAL_INDICATORS=true
EXTERNAL_INDICATORS_MODE=live
NEWS_PROVIDER=gdelt
EXTERNAL_CACHE_DIR=/opt/fuelsight/artifacts/external
MODEL_ARTIFACTS_DIR=/opt/fuelsight/artifacts/models
NEWS_INDEX_DIR=/opt/fuelsight/artifacts/news
FEATURE_STORE_DIR=/opt/fuelsight/artifacts/models/features
PIPELINE_SALES_INBOX_DIR=/opt/fuelsight/inbox/sales
PIPELINE_PURCHASES_INBOX_DIR=/opt/fuelsight/inbox/purchases
PIPELINE_INBOX_ARCHIVE_DIR=/opt/fuelsight/inbox/archive
IMPORT_MAX_UPLOAD_BYTES=10485760
IMPORT_MAX_ROWS=50000
FUELSIGHT_SEED_DEMO_USERS=false
DEFENSE_MODE=true
DEFENSE_PROFILE=cloud-enhanced

VITE_API_BASE_URL=/api/v1
VITE_ENABLE_LLM=true
VITE_ENABLE_DEMO_CREDENTIALS=true
VITE_DEFAULT_PRODUCT=AI_95

AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=GENERATE_WITH_FERNET_COMMAND
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-webserver:8080/execution/
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=True
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://fuelsight:GENERATE_A_UNIQUE_DATABASE_PASSWORD@db:5432/airflow
AIRFLOW__API_AUTH__JWT_SECRET=GENERATE_A_UNIQUE_AIRFLOW_JWT_SECRET
AIRFLOW__API__SECRET_KEY=GENERATE_A_UNIQUE_AIRFLOW_SECRET
AIRFLOW__API__PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow_admin
_AIRFLOW_WWW_USER_PASSWORD=GENERATE_A_UNIQUE_AIRFLOW_PASSWORD
