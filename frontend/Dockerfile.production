# syntax=docker/dockerfile:1.7
FROM node:24-alpine AS build

WORKDIR /workspace
RUN corepack enable

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY frontend/package.json frontend/package.json
COPY frontend ./frontend
RUN pnpm install --filter frontend --frozen-lockfile

WORKDIR /workspace/frontend
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_ENABLE_LLM=true
ARG VITE_ENABLE_DEMO_CREDENTIALS=true
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ENABLE_LLM=$VITE_ENABLE_LLM
ENV VITE_ENABLE_DEMO_CREDENTIALS=$VITE_ENABLE_DEMO_CREDENTIALS
RUN pnpm build

FROM nginx:1.29-alpine
RUN apk upgrade --no-cache
COPY frontend/nginx/nginx.conf /etc/nginx/nginx.conf
COPY frontend/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run /etc/nginx/conf.d
USER nginx
EXPOSE 3000
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
